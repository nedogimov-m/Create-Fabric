{
  "model": {
    "type": "minecraft:select",
    "property": "create:clipboard_type",
    "cases": [
      {
        "when": "empty",
        "model": {
          "type": "minecraft:model",
          "model": "create:item/clipboard_0"
        }
      },
      {
        "when": "written",
        "model": {
          "type": "minecraft:model",
          "model": "create:item/clipboard_1"
        }
      },
      {
        "when": "editing",
        "model": {
          "type": "minecraft:model",
          "model": "create:item/clipboard_2"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "create:item/clipboard_0"
    }
  }
}
